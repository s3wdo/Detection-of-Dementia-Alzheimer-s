# Copy to backend/.env and change every value marked CHANGE-ME. Never commit .env.

APP_ENV=development

# Cloud server only: the public address for HTTPS, e.g. 203-0-113-7.sslip.io
# DOMAIN=

# PostgreSQL (the docker-compose service is called "db")
POSTGRES_USER=neurosense
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=neurosense
DATABASE_URL=postgresql+psycopg://neurosense:CHANGE-ME@db:5432/neurosense

# Signing key for access tokens. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE-ME
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

# Password given to every fictional seed account (development only).
SEED_PASSWORD=CHANGE-ME

# Uploads
MAX_IMAGE_SIDE=256
MAX_IMAGE_BYTES=1048576
MAX_BODY_BYTES=2097152

# Workflow setting, not a measure of clinical reliability.
CONFIDENCE_GATE=0.80

# Image bytes are removed this many days after the doctor's review.
IMAGE_RETENTION_DAYS=30

# Model: put model.pt and model_config.yaml in backend/models/. Without them the stub predictor is used.
MODEL_PATH=models/model.pt
MODEL_CONFIG_PATH=models/model_config.yaml
# The pickle fallback runs code from the file. Enable only for a file you trust.
ALLOW_PICKLED_MODEL=false
